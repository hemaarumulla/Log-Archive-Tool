#!/bin/sh

# Check if a directory argument was provided
if [ $# -ne 1 ]; then
    echo "Usage: log-archive <log-directory>"
    exit 1
fi

# Store the log directory argument
LOG_DIR=$1

# Check if the directory exists
if [ ! -d "$LOG_DIR" ]; then
    echo "Error: Directory '$LOG_DIR' does not exist."
    exit 1
fi

# Create archive directory
ARCHIVE_DIR="$HOME/log_archives"

mkdir -p "$ARCHIVE_DIR"

# Generate timestamp
TIMESTAMP=$(date +"%Y%m%d_%H%M%S")

# Archive filename
ARCHIVE_NAME="logs_archive_${TIMESTAMP}.tar.gz"

# Full archive path
ARCHIVE_PATH="$ARCHIVE_DIR/$ARCHIVE_NAME"

# Compress the logs
tar -czf "$ARCHIVE_PATH" "$LOG_DIR"

# Check if archive was created successfully
if [ $? -eq 0 ]; then

    echo "Logs archived successfully."

    echo "$(date '+%Y-%m-%d %H:%M:%S') - Archive created: $ARCHIVE_PATH" \
    >> "$ARCHIVE_DIR/archive.log"

else

    echo "Error: Failed to archive logs."
    exit 1

fi
